{
  "name": "hackgraph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://hackgraph.github.io/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/gen-reference.ts",
    "gen:reference": "tsx scripts/gen-reference.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:refs": "node scripts/check-refs.mjs",
    "lint": "eslint ."
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@tailwindcss/vite": {
      "vite": "$vite"
    },
    "esbuild": "^0.25.0",
    "form-data": "^4.0.6"
  }
}
